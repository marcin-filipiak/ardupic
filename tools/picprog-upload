#!/bin/bash
# picprog-upload - upload driver for the bundled picprog (JDM/FTDI).
#
# Translates arduino-cli arguments into a picprog invocation:
#   -d, --device <mcu>   device name (e.g. PIC18F25K80)
#   -p, --port   <port>  serial port (e.g. /dev/ttyUSB0)
#   -f, --file   <hex>   Intel HEX file
#
# The default programmer is JDM; set PICPROG_HW=k8048 to select K8048.
set -u

HERE="$(cd "$(dirname "$0")" && pwd)"
PICPROG="$HERE/../toolchain/picprog/bin/picprog"

device=""
port=""
hex=""
hw="${PICPROG_HW:-jdm}"

while [ $# -gt 0 ]; do
    case "$1" in
        -d|--device) device="${2:-}"; shift 2 ;;
        -p|--port)   port="${2:-}";   shift 2 ;;
        -f|--file)   hex="${2:-}";    shift 2 ;;
        -v|-q)       shift ;;
        *)           shift ;;
    esac
done

if [ ! -x "$PICPROG" ]; then
    echo "picprog-upload: bundled picprog not found ($PICPROG)" >&2
    echo "  Build it with:  $HERE/../toolchain/picprog/build.sh" >&2
    exit 1
fi

if [ -z "$hex" ]; then
    echo "picprog-upload: no HEX file given (-f)" >&2
    exit 1
fi

args=(--erase --burn)
case "$hw" in
    k8048) args+=(--k8048) ;;
    *)     args+=(--jdm) ;;
esac
[ -n "$device" ] && args+=(-d "$device")
[ -n "$port" ]   && args+=(-p "$port")
args+=(-i "$hex")

exec "$PICPROG" "${args[@]}"
