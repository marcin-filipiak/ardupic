#!/bin/bash
# picprog-upload - sterownik wgrywania dla osadzonego picprog (JDM/FTDI).
#
# Tłumaczy argumenty arduino-cli na wywołanie picprog:
#   -d, --device <mcu>   nazwa układu (np. PIC18F25K80)
#   -p, --port   <port>  port szeregowy (np. /dev/ttyUSB0)
#   -f, --file   <hex>   plik Intel HEX
#
# Domyślny programer to JDM; ustaw PICPROG_HW=k8048 aby wybrać K8048.
set -u

HERE="$(cd "$(dirname "$0")" && pwd)"
PICPROG="$HERE/../toolchain/picprog/bin/picprog"

device=""
port=""
hex=""
hw="${PICPROG_HW:-jdm}"

while [ $# -gt 0 ]; do
    case "$1" in
        -d|--device) device="${2:-}"; shift 2 ;;
        -p|--port)   port="${2:-}";   shift 2 ;;
        -f|--file)   hex="${2:-}";    shift 2 ;;
        -v|-q)       shift ;;
        *)           shift ;;
    esac
done

if [ ! -x "$PICPROG" ]; then
    echo "picprog-upload: brak osadzonego picprog ($PICPROG)" >&2
    echo "  Zbuduj go:  $HERE/../toolchain/picprog/build.sh" >&2
    exit 1
fi

if [ -z "$hex" ]; then
    echo "picprog-upload: nie podano pliku HEX (-f)" >&2
    exit 1
fi

args=(--erase --burn)
case "$hw" in
    k8048) args+=(--k8048) ;;
    *)     args+=(--jdm) ;;
esac
[ -n "$device" ] && args+=(-d "$device")
[ -n "$port" ]   && args+=(-p "$port")
args+=(-i "$hex")

exec "$PICPROG" "${args[@]}"
